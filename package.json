{
  "name": "homebridge-hiot-autoever",
  "version": "0.0.0",
  "description": "Homebridge plugin for Hi-oT (Hyundai Autoever) KOCOM wallpad-based Korean apartments — exposes lights, outlets, switches, AC, ventilation, heating, gas valve, and elevator call to Apple HomeKit and Siri.",
  "license": "Apache-2.0",
  "author": "ywkim",
  "type": "commonjs",
  "main": "dist/index.js",
  "homepage": "https://github.com/ywkim/homebridge-hiot-autoever#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywkim/homebridge-hiot-autoever.git"
  },
  "bugs": {
    "url": "https://github.com/ywkim/homebridge-hiot-autoever/issues"
  },
  "engines": {
    "node": ">=20.18.1",
    "homebridge": ">=1.6.1 || >=2.0.0-beta.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --coverage"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "siri",
    "hiot",
    "hi-ot",
    "hyundai-autoever",
    "kocom",
    "wallpad",
    "월패드",
    "korean-apartment",
    "smarthome",
    "smart-home",
    "iot",
    "hillstate",
    "힐스테이트"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywkim/homebridge-hiot-autoever.git"
  },
  "bugs": {
    "url": "https://github.com/ywkim/homebridge-hiot-autoever/issues"
  },
  "homepage": "https://github.com/ywkim/homebridge-hiot-autoever#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "pino": "^9.5.0",
    "tough-cookie": "^5.0.0",
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "homebridge": ">=1.6.1 || >=2.0.0-beta.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.6.0",
    "homebridge": "~1.6.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
