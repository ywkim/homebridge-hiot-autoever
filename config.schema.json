{
  "pluginAlias": "HiotAutoever",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Homebridge plugin for Hi-oT (Hyundai Autoever) KOCOM wallpad-based Korean apartments.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "HiotAutoever"
      },
      "userid": {
        "title": "User ID",
        "type": "string"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10
      },
      "debugLogging": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      }
    },
    "required": ["name", "userid", "password"]
  }
}
